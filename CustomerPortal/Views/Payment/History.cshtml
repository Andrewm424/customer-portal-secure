@model IEnumerable<Payment>
@{
    ViewData["Title"] = "Payment History";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var username = Context.Session.GetString("CustomerUsername");

    string GetCurrencySymbol(string code)
    {
        return code switch
        {
            "USD" => "$",
            "EUR" => "€",
            "GBP" => "£",
            "ZAR" => "R",
            _ => ""
        };
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary d-flex align-items-center">
        <i class="bi bi-clock-history me-2"></i> Payment History
    </h2>

    @if (!string.IsNullOrEmpty(username))
    {
        <a asp-controller="Payment" asp-action="MakePayment" class="btn btn-outline-primary shadow-sm">
            <i class="bi bi-plus-circle-fill"></i> Make Payment
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info shadow-sm">
        <i class="bi bi-info-circle-fill"></i> You haven't made any international payments yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-striped table-bordered align-middle shadow-sm">
            <thead class="table-primary text-center">
                <tr>
                    <th scope="col"><i class="bi bi-cash-coin"></i> Amount</th>
                    <th scope="col"><i class="bi bi-currency-bitcoin"></i> Currency</th>
                    <th scope="col"><i class="bi bi-bank"></i> Provider</th>
                    <th scope="col"><i class="bi bi-person-badge-fill"></i> Payee</th>
                    <th scope="col"><i class="bi bi-arrow-left-right"></i> SWIFT</th>
                    <th scope="col"><i class="bi bi-calendar-event"></i> Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.OrderByDescending(p => p.SubmittedAt))
                {
                    var symbol = GetCurrencySymbol(p.Currency);
                    <tr class="text-center">
                        <td>@($"{symbol}{p.Amount:N2}")</td>
                        <td>@p.Currency</td>
                        <td>@p.Provider</td>
                        <td>@p.PayeeAccount</td>
                        <td>@p.SwiftCode</td>
                        <td>@p.SubmittedAt.ToString("dd MMM yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
