@model IEnumerable<Payment>
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_EmployeeLayout.cshtml";

    string GetSymbol(string currency) => currency switch
    {
        "USD" => "$",
        "EUR" => "€",
        "GBP" => "£",
        "ZAR" => "R",
        _ => ""
    };
}

<h2 class="mb-4"><i class="bi bi-table"></i> Payment Review Dashboard</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success"><i class="bi bi-check-circle"></i> @TempData["Success"]</div>
}

<form method="post" asp-action="SubmitToSwift">
    <button type="submit" class="btn btn-success mb-3">
        <i class="bi bi-send-check-fill"></i> Submit Verified to SWIFT
    </button>
</form>

<table class="table table-striped table-bordered shadow-sm align-middle">
    <thead class="table-dark text-center">
        <tr>
            <th><i class="bi bi-cash-coin"></i> Amount</th>
            <th><i class="bi bi-currency-exchange"></i> Currency</th>
            <th><i class="bi bi-person-lines-fill"></i> Payee</th>
            <th><i class="bi bi-arrow-left-right"></i> SWIFT</th>
            <th><i class="bi bi-check2-square"></i> Verified</th>
            <th><i class="bi bi-tools"></i> Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            var symbol = GetSymbol(p.Currency);
            <tr class="text-center">
                <td>@($"{symbol}{p.Amount:N2}")</td>
                <td>@p.Currency</td>
                <td>@p.PayeeAccount</td>
                <td>@p.SwiftCode</td>
                <td>
                    @if (p.IsVerified)
                    {
                        <span class="badge bg-success"><i class="bi bi-patch-check-fill"></i> Verified</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> Pending</span>
                    }
                </td>
                <td>
                    @if (!p.IsVerified)
                    {
                        <form asp-action="Verify" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@p.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-check2-circle"></i> Verify
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-success disabled">
                            <i class="bi bi-check-circle-fill"></i> Done
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
